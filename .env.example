# Copy this file to .env and adjust values as needed
# Use Docker AI Gateway for models and tools (no OpenAI/Anthropic keys required)
CAGENT_MODELS_GATEWAY=https://gw.docker.com/models
# Optionally set tools gateway (defaults to CAGENT_MODELS_GATEWAY if unset)
# CAGENT_TOOLS_GATEWAY=https://gw.docker.com/tools

# Path to cagent repository (for auto-loading example agent configs)
# Set this to the root directory of your cagent repository
CAGENT_REPO_PATH=/Users/a-dubs/git/cagent

# If you prefer direct providers instead of the Docker AI Gateway, set one of these:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...
